# Estado final del Moodle de CONAF — sobre PostgreSQL 17 compartido.
# Copiar como .env en /opt/apps/coipo_moodle/ del servidor y hacer chmod 600.
#
# ESTE ARCHIVO SE VERSIONA. Nunca escribir aquí una contraseña real: quedaría en
# GitHub para siempre. La clave real vive solo en el .env del servidor.

# ─── Base de datos (PostgreSQL 17 compartido, 172.31.2.40) ──────────────────
MOODLE_DBTYPE=pgsql
DATABASE_HOST=172.31.2.40
DATABASE_PORT=5432
DATABASE_USER=academia
DATABASE_NAME=academia_prod
# La clave real va SOLO en el .env del servidor. Generar con: openssl rand -hex 32
DATABASE_PASSWORD=
MOODLE_DBPREFIX=mdl_

# El PostgreSQL de CONAF rechaza la negociación GSSAPI y TLS: sin estas dos, la
# conexión falla con "could not initiate GSSAPI security context" (está
# documentado en INSUMO/fastapi-postgresql-conexion.md). Moodle no expone esos
# parámetros en su configuración, pero libpq —la biblioteca que usa por debajo—
# los lee de estas variables de entorno.
PGGSSENCMODE=disable
PGSSLMODE=disable

# ─── Sitio ──────────────────────────────────────────────────────────────────
# Debe coincidir EXACTAMENTE con la URL por la que se entra, incluido el puerto.
# Si no coincide: bucle de redirección, o CSS y JS que no cargan.
#
# El destino definitivo es academia.conaf.cl. Progresión:
#   1. Pruebas, sin DNS todavía:  http://172.31.2.41:8115
#   2. Con DNS, aún sin TLS:      http://academia.conaf.cl   + REVERSEPROXY=true
#   3. Con certificado:           https://academia.conaf.cl  + SSLPROXY=true
#
# OJO: el contenido de los cursos trae 20.994 enlaces absolutos al dominio
# anterior (campus.conaf.cl), que queda descontinuado. Hay que reescribirlos:
# ver "URLs antiguas dentro del contenido" en docs/MIGRACION.md.
MOODLE_WWWROOT=http://172.31.2.41:8115

# El servidor sirve HTTP plano por ahora. Ambas en true solo cuando Nginx
# termine TLS con el certificado *.conaf.cl: con sslproxy=true sobre HTTP las
# cookies se marcan Secure y el login deja de funcionar.
MOODLE_REVERSEPROXY=false
MOODLE_SSLPROXY=false

# ─── SEGURIDAD: correo saliente ─────────────────────────────────────────────
# Esta es una copia de producción con ~2.800 correos institucionales REALES. En
# cuanto el cron arranque, Moodle enviaría digests de foro, notificaciones y
# avisos de contraseña a funcionarios de verdad.
# Mantener en true hasta que exista una decisión explícita de reactivar correo.
MOODLE_NOEMAILEVER=true

# Solo para diagnosticar un problema puntual. Jamás true en producción.
MOODLE_DEBUG=false

# ─── Rutas del host ─────────────────────────────────────────────────────────
# Fuera de /opt/apps/ a propósito: el deploy sincroniza esa carpeta y un borrado
# accidental se llevaría los 10,9 GB de contenido de los cursos.
MOODLEDATA_HOST_PATH=/opt/moodledata/coipo_moodle

# ─── Puerto publicado (el que necesita conocer el Nginx del servidor) ───────
APP_PORT=8115

# ─── Versión de Moodle que construye la imagen ──────────────────────────────
MOODLE_VERSION=v4.5.10
